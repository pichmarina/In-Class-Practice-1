<h2>Item Details</h2>

<p><strong>Name:</strong> {{report.name}}</p>
<p><strong>Description:</strong> {{report.description}}</p>
<p><strong>Location:</strong> {{report.location}}</p>
<p><strong>Date:</strong> {{report.date}}</p>
<p><strong>Contact:</strong> {{report.contact}}</p>
<p><strong>Status:</strong> {{report.status}}</p>

<img src="{{report.imagePath}}" width="300">

<h3>Change Status</h3>
<form action="/items/{{report.id}}/status" method="POST">
    <select name="status">
        <option>Lost</option>
        <option>Found</option>
        <option>Closed</option>
    </select>
    <button type="submit">Update</button>
</form>

<h3>Delete</h3>
<form action="/items/{{report.id}}/delete" method="POST">
    <button type="submit" style="color:red;">Delete Report</button>
</form>